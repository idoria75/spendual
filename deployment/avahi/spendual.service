<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Announces the web app on the LAN. Host name spendual.local comes from the host name of the box:
     set it with: sudo hostnamectl set-hostname spendual -->
<service-group>
  <name>Spendual</name>
  <service>
    <type>_http._tcp</type>
    <port>80</port>
  </service>
</service-group>
