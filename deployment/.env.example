# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit .env.
# Make secrets with:  openssl rand -hex 24
# Use hex or letters and digits only: MYSQL_PASSWORD goes into a URL.

# MySQL root password. Also goes into the root-only file used by backup.sh.
MYSQL_ROOT_PASSWORD=
# Password of the "spendual" database user used by the app.
MYSQL_PASSWORD=
# Signs session cookies. At least 32 characters. Use:  openssl rand -hex 32
SESSION_SECRET=

# Host folder with the backups, mounted read-only into the app at /backups.
# Must be the same folder backup.sh writes to.
BACKUP_DIR=/srv/spendual-backups

# Host port for the app. 80 gives http://spendual.local with no port.
APP_PORT=80

TZ=America/Sao_Paulo

# Express "trust proxy" for the login rate limit. Leave empty (off) unless a reverse proxy is in
# front. A number is the count of proxy hops, for example 1.
TRUST_PROXY=
