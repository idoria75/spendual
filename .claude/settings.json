{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(make lint:*)",
      "Bash(make typecheck:*)",
      "Bash(make test:*)",
      "Bash(make format-check:*)",
      "Bash(make backup-dev:*)"
    ],
    "deny": [
      "Bash(docker volume rm:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker compose * down -v:*)",
      "Bash(*migrate reset*)"
    ]
  }
}
