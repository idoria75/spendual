generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Household {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now())
}

model User {
  id             Int                      @id @default(autoincrement())
  username       String                   @unique @db.VarChar(60)
  passwordHash   String                   @db.VarChar(255)
  displayName    String                   @db.VarChar(80)
  tonePalette    String?                  @unique @db.VarChar(30)
  active         Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  ruleOwner      RecurrenceRule[]         @relation("RuleOwner")
  rulePayer      RecurrenceRule[]         @relation("RulePayer")
  ruleCreated    RecurrenceRule[]         @relation("RuleCreatedBy")
  ruleUpdated    RecurrenceRule[]         @relation("RuleUpdatedBy")
  planOwner      InstallmentPlan[]        @relation("PlanOwner")
  planPayer      InstallmentPlan[]        @relation("PlanPayer")
  planCreated    InstallmentPlan[]        @relation("PlanCreatedBy")
  planUpdated    InstallmentPlan[]        @relation("PlanUpdatedBy")
  txPayer        Transaction[]            @relation("TxPayer")
  txOwner        Transaction[]            @relation("TxOwner")
  txCreated      Transaction[]            @relation("TxCreatedBy")
  txUpdated      Transaction[]            @relation("TxUpdatedBy")
  allowanceOwned PersonalAllowanceEntry[] @relation("AllowanceOwner")
  allowanceActed PersonalAllowanceEntry[] @relation("AllowanceActor")
  budgetsUpdated MonthlyBudget[]          @relation("BudgetUpdatedBy")
  goalsCreated   SavingsGoal[]            @relation("GoalCreatedBy")
  goalsUpdated   SavingsGoal[]            @relation("GoalUpdatedBy")
  goalEntries    GoalEntry[]              @relation("GoalEntryActor")
  auditEvents    AuditEvent[]             @relation("AuditActor")
}

model Category {
  id               Int               @id @default(autoincrement())
  name             String            @unique @db.VarChar(80)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  recurrenceRules  RecurrenceRule[]
  installmentPlans InstallmentPlan[]
  transactions     Transaction[]
  budgets          MonthlyBudget[]
}

enum AccountType {
  bank
  cash
  credit_card
  other
}

model Account {
  id               Int               @id @default(autoincrement())
  name             String            @unique @db.VarChar(80)
  type             AccountType
  currency         String            @default("BRL") @db.VarChar(3)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  recurrenceRules  RecurrenceRule[]
  installmentPlans InstallmentPlan[]
  transactions     Transaction[]
}

model PaymentMethod {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(80)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recurrenceRules RecurrenceRule[]
  transactions    Transaction[]
}

enum Scope {
  household
  personal
}

enum RecurrenceState {
  active
  paused
  ended
}

enum OccurrenceStatus {
  planned
  confirmed
  cancelled
}

model RecurrenceRule {
  id              Int             @id @default(autoincrement())
  description     String          @db.VarChar(200)
  expectedAmount  Decimal?        @db.Decimal(12, 2)
  currency        String          @default("BRL") @db.VarChar(3)
  dayOfMonth      Int             @db.TinyInt
  startDate       DateTime        @db.Date
  endDate         DateTime?       @db.Date
  state           RecurrenceState @default(active)
  scope           Scope
  ownerId         Int?
  payerId         Int?
  categoryId      Int?
  accountId       Int?
  paymentMethodId Int?
  createdById     Int
  updatedById     Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  owner         User?                  @relation("RuleOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payer         User?                  @relation("RulePayer", fields: [payerId], references: [id])
  createdBy     User                   @relation("RuleCreatedBy", fields: [createdById], references: [id])
  updatedBy     User                   @relation("RuleUpdatedBy", fields: [updatedById], references: [id])
  category      Category?              @relation(fields: [categoryId], references: [id])
  account       Account?               @relation(fields: [accountId], references: [id])
  paymentMethod PaymentMethod?         @relation(fields: [paymentMethodId], references: [id])
  occurrences   RecurrenceOccurrence[]

  @@index([ownerId])
  @@index([payerId])
  @@index([categoryId])
  @@index([accountId])
  @@index([paymentMethodId])
  @@index([createdById])
  @@index([updatedById])
}

model RecurrenceOccurrence {
  id             Int              @id @default(autoincrement())
  ruleId         Int
  periodKey      String           @db.VarChar(7)
  dueDate        DateTime         @db.Date
  expectedAmount Decimal?         @db.Decimal(12, 2)
  status         OccurrenceStatus @default(planned)
  createdAt      DateTime         @default(now())

  rule        RecurrenceRule @relation(fields: [ruleId], references: [id])
  transaction Transaction?

  @@unique([ruleId, periodKey])
  @@index([dueDate])
}

model InstallmentPlan {
  id               Int      @id @default(autoincrement())
  description      String   @db.VarChar(200)
  totalAmount      Decimal  @db.Decimal(12, 2)
  currency         String   @default("BRL") @db.VarChar(3)
  installmentCount Int
  firstDueDate     DateTime @db.Date
  scope            Scope
  ownerId          Int?
  payerId          Int?
  categoryId       Int?
  accountId        Int?
  notes            String?  @db.VarChar(500)
  createdById      Int
  updatedById      Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner       User?                   @relation("PlanOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payer       User?                   @relation("PlanPayer", fields: [payerId], references: [id])
  createdBy   User                    @relation("PlanCreatedBy", fields: [createdById], references: [id])
  updatedBy   User                    @relation("PlanUpdatedBy", fields: [updatedById], references: [id])
  category    Category?               @relation(fields: [categoryId], references: [id])
  account     Account?                @relation(fields: [accountId], references: [id])
  occurrences InstallmentOccurrence[]

  @@index([ownerId])
  @@index([payerId])
  @@index([categoryId])
  @@index([accountId])
  @@index([createdById])
  @@index([updatedById])
}

model InstallmentOccurrence {
  id             Int              @id @default(autoincrement())
  planId         Int
  sequenceNumber Int
  dueDate        DateTime         @db.Date
  expectedAmount Decimal          @db.Decimal(12, 2)
  status         OccurrenceStatus @default(planned)
  createdAt      DateTime         @default(now())

  plan        InstallmentPlan @relation(fields: [planId], references: [id])
  transaction Transaction?

  @@unique([planId, sequenceNumber])
  @@index([dueDate])
}

enum TransactionType {
  expense
  income
  other_receipt
  refund
  transfer
}

enum TransactionStatus {
  planned
  confirmed
  cancelled
  voided
}

enum TransactionSource {
  manual
  import
}

model Transaction {
  id                      Int               @id @default(autoincrement())
  type                    TransactionType
  status                  TransactionStatus
  amount                  Decimal           @db.Decimal(12, 2)
  currency                String            @default("BRL") @db.VarChar(3)
  description             String            @db.VarChar(200)
  transactionDate         DateTime          @db.Date
  expectedDate            DateTime?         @db.Date
  categoryId              Int?
  accountId               Int?
  paymentMethodId         Int?
  payerId                 Int?
  scope                   Scope
  ownerId                 Int?
  source                  TransactionSource @default(manual)
  externalRef             String?           @db.VarChar(120)
  relatedTransactionId    Int?
  recurrenceOccurrenceId  Int?              @unique
  installmentOccurrenceId Int?              @unique
  notes                   String?           @db.VarChar(500)
  voidReason              String?           @db.VarChar(500)
  createdById             Int
  updatedById             Int
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  category              Category?              @relation(fields: [categoryId], references: [id])
  account               Account?               @relation(fields: [accountId], references: [id])
  paymentMethod         PaymentMethod?         @relation(fields: [paymentMethodId], references: [id])
  payer                 User?                  @relation("TxPayer", fields: [payerId], references: [id])
  owner                 User?                  @relation("TxOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy             User                   @relation("TxCreatedBy", fields: [createdById], references: [id])
  updatedBy             User                   @relation("TxUpdatedBy", fields: [updatedById], references: [id])
  relatedTransaction    Transaction?           @relation("TxRelated", fields: [relatedTransactionId], references: [id])
  relatedFrom           Transaction[]          @relation("TxRelated")
  recurrenceOccurrence  RecurrenceOccurrence?  @relation(fields: [recurrenceOccurrenceId], references: [id])
  installmentOccurrence InstallmentOccurrence? @relation(fields: [installmentOccurrenceId], references: [id])

  @@index([transactionDate])
  @@index([status])
  @@index([categoryId])
  @@index([accountId])
  @@index([paymentMethodId])
  @@index([payerId])
  @@index([ownerId])
  @@index([createdById])
  @@index([updatedById])
  @@index([relatedTransactionId])
}

enum AllowanceKind {
  ALLOCATION
  ADJUSTMENT
  CORRECTION
}

// Append-only ledger. Balance is always the sum of rows.
// "One ALLOCATION per owner and period" is enforced in the service layer, not here.
model PersonalAllowanceEntry {
  id        Int           @id @default(autoincrement())
  ownerId   Int
  periodKey String        @db.VarChar(7)
  kind      AllowanceKind
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("BRL") @db.VarChar(3)
  notes     String?       @db.VarChar(500)
  actorId   Int
  createdAt DateTime      @default(now())

  owner User @relation("AllowanceOwner", fields: [ownerId], references: [id])
  actor User @relation("AllowanceActor", fields: [actorId], references: [id])

  @@index([ownerId, periodKey])
  @@index([actorId])
}

enum BudgetScope {
  OVERALL
  CATEGORY
}

model MonthlyBudget {
  id            Int         @id @default(autoincrement())
  scope         BudgetScope
  categoryId    Int?
  // "overall" or the category id as a string. Needed because UNIQUE allows many NULLs.
  categoryKey   String      @db.VarChar(20)
  // Period key YYYY-MM. The row applies from this month until a later row exists.
  effectiveFrom String      @db.VarChar(7)
  amount        Decimal     @db.Decimal(12, 2)
  currency      String      @default("BRL") @db.VarChar(3)
  updatedById   Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User?     @relation("BudgetUpdatedBy", fields: [updatedById], references: [id])

  @@unique([categoryKey, effectiveFrom])
  @@index([categoryId])
  @@index([updatedById])
}

enum GoalStatus {
  active
  completed
  archived
}

enum GoalEntryKind {
  ALLOCATION
  WITHDRAWAL
  CORRECTION
}

model SavingsGoal {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(120)
  description  String?    @db.VarChar(500)
  targetAmount Decimal?   @db.Decimal(12, 2)
  targetDate   DateTime?  @db.Date
  currency     String     @default("BRL") @db.VarChar(3)
  status       GoalStatus @default(active)
  createdById  Int
  updatedById  Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  createdBy User        @relation("GoalCreatedBy", fields: [createdById], references: [id])
  updatedBy User        @relation("GoalUpdatedBy", fields: [updatedById], references: [id])
  entries   GoalEntry[]

  @@index([createdById])
  @@index([updatedById])
}

// Append-only. Correct mistakes by adding entries, never by editing rows.
model GoalEntry {
  id            Int           @id @default(autoincrement())
  goalId        Int
  kind          GoalEntryKind
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("BRL") @db.VarChar(3)
  effectiveDate DateTime      @db.Date
  actorId       Int
  notes         String?       @db.VarChar(500)
  createdAt     DateTime      @default(now())

  goal  SavingsGoal @relation(fields: [goalId], references: [id])
  actor User        @relation("GoalEntryActor", fields: [actorId], references: [id])

  @@index([goalId])
  @@index([actorId])
}

model AuditEvent {
  id         Int      @id @default(autoincrement())
  actorId    Int
  entityType String   @db.VarChar(60)
  entityId   String   @db.VarChar(40)
  action     String   @db.VarChar(40)
  before     Json?
  after      Json?
  reason     String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
}
